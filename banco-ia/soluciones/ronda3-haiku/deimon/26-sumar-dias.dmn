# Sumar N días a una fecha

funcion dia_juliano(y, m, d) {
    sea a = suelo((14 - m) / 12)
    sea yy = y + 4800 - a
    sea mm = m + 12 * a - 3
    devolver d + suelo((153 * mm + 2) / 5) + 365 * yy + suelo(yy / 4) - suelo(yy / 100) + suelo(yy / 400) - 32045
}

funcion fecha_de_juliano(j) {
    sea a = j + 32044
    sea b = suelo((4 * a + 3) / 146097)
    sea c = a - suelo(146097 * b / 4)
    sea d = suelo((4 * c + 3) / 1461)
    sea e = c - suelo(1461 * d / 4)
    sea m = suelo((5 * e + 2) / 153)
    sea dia = e - suelo((153 * m + 2) / 5) + 1
    sea mes = m + 3 - 12 * suelo(m / 10)
    sea anio = 100 * b + d - 4800 + suelo(m / 10)
    devolver rellenar_texto(a_texto(anio), 4, "0", "izquierda") + "-" + rellenar_texto(a_texto(mes), 2, "0", "izquierda") + "-" + rellenar_texto(a_texto(dia), 2, "0", "izquierda")
}

sea linea = pedir_texto("")
mientras linea != nada {
    sea p = partir(recortar(linea), " ")
    sea f = partir(p[0], "-")
    sea j = dia_juliano(a_numero(f[0]), a_numero(f[1]), a_numero(f[2])) + a_numero(p[1])
    mostrar(fecha_de_juliano(j))
    linea = pedir_texto("")
}
