# IVA con redondeo hacia arriba en la mitad, todo en céntimos
funcion a_centimos(t) {
    sea partes = partir(t, ".")
    sea c = a_numero(partes[0]) * 100
    si medir(partes) > 1 {
        c = c + a_numero(rellenar_texto(partes[1], 2, "0", "derecha"))
    }
    devolver c
}

funcion dinero(c) {
    sea t = rellenar_texto(a_texto(c), 3, "0", "izquierda")
    devolver cortar(t, 0, medir(t) - 2) + "." + cortar(t, medir(t) - 2, nada)
}

sea suma = 0
sea partes = []
sea base = 0
sea tipo = 0
sea iva = 0
sea total = 0
sea linea = pedir_texto("")
mientras linea != nada {
    partes = partir(recortar(linea), " ")
    base = a_centimos(partes[0])
    tipo = a_numero(partes[1])
    iva = suelo((base * tipo + 50) / 100)
    total = base + iva
    suma = suma + total
    mostrar(partes[0] + " " + a_texto(tipo) + "% -> iva " + dinero(iva) + " total " + dinero(total))
    linea = pedir_texto("")
}
mostrar("suma de totales: " + dinero(suma))
