sea patron = "^(\\d{4})-(\\d{2})-(\\d{2}) (\\d{2}):(\\d{2}):(\\d{2}) \\[(INFO|WARN|ERROR)\\] (\\d{1,3}(?:\\.\\d{1,3}){3}) (GET|POST|PUT|DELETE) (/\\S*) (\\d{3})$"
sea niveles = {"ERROR": 0, "INFO": 0, "WARN": 0}
sea estados = {}
sea horas = {}
sea rutas = {}
sea validas = 0
sea total = 0
sea linea = pedir_texto("")
mientras linea != nada {
    total = total + 1
    sea m = buscar_patron(linea, patron)
    si m != nada {
        validas = validas + 1
        niveles[m[7]] = niveles[m[7]] + 1
        estados[m[11]] = elegir(tiene_clave(estados, m[11]), estados[m[11]], 0) + 1
        horas[m[4]] = elegir(tiene_clave(horas, m[4]), horas[m[4]], 0) + 1
        rutas[m[10]] = elegir(tiene_clave(rutas, m[10]), rutas[m[10]], 0) + 1
    }
    linea = pedir_texto("")
}
mostrar("validas: " + validas)
mostrar("invalidas: " + (total - validas))
para n en ["ERROR", "INFO", "WARN"] {
    mostrar(n + ": " + niveles[n])
}
sea codigos = []
para e en listar_claves(estados) {
    codigos = agregar(codigos, a_numero(e))
}
sea partes = []
para e en ordenar(codigos) {
    partes = agregar(partes, a_texto(e) + "=" + estados[a_texto(e)])
}
mostrar("estados: " + elegir(medir(partes) == 0, "ninguno", unir(partes, " ")))
para h en ordenar(listar_claves(horas)) {
    mostrar("hora " + h + ": " + horas[h])
}
sea mejor = nada
para r en ordenar(listar_claves(rutas)) {
    si mejor == nada {
        mejor = r
    } sino si rutas[r] > rutas[mejor] {
        mejor = r
    }
}
si mejor == nada {
    mostrar("ruta mas pedida: ninguna")
} sino {
    mostrar("ruta mas pedida: " + mejor + " (" + rutas[mejor] + ")")
}
