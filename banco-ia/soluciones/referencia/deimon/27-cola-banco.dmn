sea k = a_numero(pedir_texto(""))
sea libres = []
para i en rango(1, k) {
    libres = agregar(libres, 0)
}
sea espera_total = 0
sea termina = 0
sea linea = pedir_texto("")
mientras linea != nada {
    sea p = partir(linea, " ")
    sea llegada = a_numero(p[0])
    sea duracion = a_numero(p[1])
    sea caja = 0
    para i en rango(0, k - 1) {
        si libres[i] < libres[caja] {
            caja = i
        }
    }
    sea empieza = maximo(llegada, libres[caja])
    libres[caja] = empieza + duracion
    espera_total = espera_total + empieza - llegada
    termina = maximo(termina, libres[caja])
    mostrar(p[2] + ": caja " + (caja + 1) + " empieza " + empieza + " espera " + (empieza - llegada))
    linea = pedir_texto("")
}
mostrar("espera total: " + espera_total)
mostrar("termina: " + termina)
