funcion segundos(texto) {
    sea p = partir(texto, "-")
    devolver crear_fecha(a_numero(p[0]), a_numero(p[1]), a_numero(p[2]), 0, 0, 0)
}

sea linea = pedir_texto("")
mientras linea != nada {
    sea p = partir(linea, " ")
    mostrar((segundos(p[1]) - segundos(p[0])) / 86400)
    linea = pedir_texto("")
}
